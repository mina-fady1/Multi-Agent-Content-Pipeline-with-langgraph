# API Keys and Environment Configuration
# Copy this file to .env and insert your real keys

# Google Gemini API Key
GEMINI_API_KEY=
# Or GOOGLE_API_KEY=

# Tavily Search API Key
TAVILY_API_KEY=

# LLM Provider selection: 'gemini' or 'ollama' (default auto-detects gemini if key present, else ollama)
LLM_PROVIDER=gemini

# Gemini Model Name (default: gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b-q4_K_M

# Missing/failed live research never falls back to fixtures.
# Use CLI --demo-research for labelled preview-only fixtures; an LLM is still required.
# Gemini costs use model-specific standard paid text rates. Unknown prices remain null.
